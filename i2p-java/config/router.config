# I2P (Java) router configuration for I2Pd Browser.
#
# Only the values I2Pd Browser needs to control explicitly are listed
# here; everything else uses the router's built-in defaults. This file
# is seeded into i2p-java/data/ on first run and is never overwritten
# afterwards.
#
# Reference: https://geti2p.net/en/docs/configuration

# Bandwidth limits. 2048 KB/s (i2pd "P" profile); with the default
# 80% share this advertises the I2P "P" (extra) capability class.
i2np.bandwidth.inboundBurstKBytes=22520
i2np.bandwidth.inboundBurstKBytesPerSecond=2048
i2np.bandwidth.inboundKBytesPerSecond=2048
i2np.bandwidth.outboundBurstKBytes=22520
i2np.bandwidth.outboundBurstKBytesPerSecond=2048
i2np.bandwidth.outboundKBytesPerSecond=2048

# UPnP is enabled, matching the i2pd profile.
i2np.upnp.enable=true

# Announce router updates but never download them automatically. When
# updates are enabled they must go through the local I2P HTTP proxy so
# the router never contacts the clearnet directly.
router.updatePolicy=notify
router.updateThroughProxy=true
router.updateProxyHost=127.0.0.1
router.updateProxyPort=4444
