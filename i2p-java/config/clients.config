# Client applications started automatically by the I2P router.
#
# Only the router console and the application tunnels are started.
# The systray / URL launcher client is intentionally not listed so the
# router never opens an unrelated web browser at startup.

# Router console, bound to localhost only (IPv4 and IPv6).
clientApp.0.main=net.i2p.router.web.RouterConsoleRunner
clientApp.0.name=I2P Router Console
clientApp.0.args=7657 ::1,127.0.0.1 ./webapps/
clientApp.0.delay=0
clientApp.0.startOnLoad=true

# Application tunnels (HTTP and SOCKS proxies), see i2ptunnel.config.
clientApp.1.main=net.i2p.i2ptunnel.TunnelControllerGroup
clientApp.1.name=Application tunnels
clientApp.1.args=i2ptunnel.config
clientApp.1.delay=120
clientApp.1.startOnLoad=true
