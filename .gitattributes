# Windows command scripts must keep CRLF line endings so the Command
# Prompt parses them reliably.
*.cmd text eol=crlf
*.bat text eol=crlf

# Keep data files (especially locale catalogs) byte-stable on Windows
# checkouts. A CRLF-contaminated .properties value would leak a trailing
# carriage return into user-visible messages.
*.bash text eol=lf
*.ps1 text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.json text eol=lf
*.conf text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.txt text eol=lf
*.desktop text eol=lf
*.pem text eol=lf
*.crt text eol=lf
*.csv text eol=lf
