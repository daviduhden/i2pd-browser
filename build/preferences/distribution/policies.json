{
  "policies": {
    "DisableAppUpdate": true,
    "DisableSystemAddonUpdate": true,
    "DisableTelemetry": true,
    "DisableFirefoxStudies": true,
    "DisableRemoteImprovements": true,
    "DisableFirefoxAccounts": true,
    "DisableFeedbackCommands": true,
    "BrowserDataBackup": {
      "AllowBackup": false,
      "AllowRestore": false
    },
    "AIControls": {
      "Default": {
        "Value": "blocked",
        "Locked": true
      }
    },
    "DefaultSerialGuardSetting": 2,
    "IPProtectionAvailable": false,
    "LocalNetworkAccess": {
      "Enabled": true,
      "BlockTrackers": true,
      "EnablePrompting": true,
      "Locked": true
    },
    "VisualSearchEnabled": false,
    "XSLTEnabled": false,
    "HttpsOnlyMode": "disallowed",
    "DNSOverHTTPS": {
      "Enabled": false,
      "Locked": true
    },
    "CaptivePortal": false,
    "NetworkPrediction": false,
    "DontCheckDefaultBrowser": true,
    "OverrideFirstRunPage": "http://i2pd.i2p/",
    "OverridePostUpdatePage": "",
    "Proxy": {
      "Mode": "manual",
      "Locked": true,
      "HTTPProxy": "127.0.0.1:4444",
      "SSLProxy": "127.0.0.1:4444",
      "UseProxyForDNS": true,
      "Passthrough": ""
    },
    "SearchEngines": {
      "Default": "YaCy",
      "PreventInstalls": true,
      "Add": [
        {
          "Name": "YaCy",
          "URLTemplate": "http://legwork.i2p/yacysearch.html?query={searchTerms}"
        }
      ],
      "Remove": [
        "Google",
        "Bing",
        "DuckDuckGo",
        "Yahoo",
        "Amazon.com",
        "eBay",
        "Wikipedia (en)",
        "Perplexity"
      ]
    },
    "SearchSuggestEnabled": false,
    "FirefoxHome": {
      "Search": true,
      "Weather": false,
      "TopSites": false,
      "Highlights": false,
      "Pocket": false,
      "Snippets": false,
      "SponsoredTopSites": false
    },
    "SupportMenu": {
      "Title": "ILITA IRC",
      "URL": "http://irc.r4sas.i2p/?nick=WebClient...&channels=dev%2Cen%2Cru&question=1&uio=OT10cnVlde"
    },
    "Permissions": {
      "Camera": {
        "BlockNewRequests": true
      },
      "Microphone": {
        "BlockNewRequests": true
      },
      "Location": {
        "BlockNewRequests": true
      }
    }
  }
}
